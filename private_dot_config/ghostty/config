# Macchiato
# =======================
palette = 0=#494d64
palette = 1=#ed8796
palette = 2=#a6da95
palette = 3=#eed49f
palette = 4=#8aadf4
palette = 5=#f5bde6
palette = 6=#8bd5ca
palette = 7=#a5adcb
palette = 8=#5b6078
palette = 9=#ec7486
palette = 10=#8ccf7f
palette = 11=#e1c682
palette = 12=#78a1f6
palette = 13=#f2a9dd
palette = 14=#63cbc0
palette = 15=#b8c0e0
background = #1e1d2d
foreground = #cdd6f4
cursor-color = cell-foreground
cursor-text = cell-background
selection-background = #5b6078
selection-foreground = #cad3f5
bold-color = bright

# Updates
auto-update = check
auto-update-channel = tip

# Shaders
custom-shader-animation = always
custom-shader = shaders/boo-cursor.glsl
# custom-shader = shaders/synesthaxia.glsl
# custom-shader = shaders/cursor_sweep.glsl
# custom-shader = shaders/cursor_warp.glsl
# custom-shader = shaders/ripple_cursor.glsl
# custom-shader = shaders/cursor_tail.glsl
# custom-shader = shaders/cursor_blaze.glsl
# custom-shader = shaders/fuck_cursor.glsl
# custom-shader = shaders/cursor_smear_dynamic.glsl

# NERD FONT SYMBOLS
font-codepoint-map = U+E000-U+E00A,U+E0A0-U+E0A3,U+E0B0-U+E0C8,U+E0CA,U+E0CC-U+E0D7,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6B7,U+E700-U+E8EF,U+EA60-U+EC1E,U+ED00-U+F2FF,U+EE00-U+EE0B,U+F300-U+F381,U+F400-U+F533,U+F0001-U+F1AF0=Symbols Nerd Font
# Decorations
macos-window-shadow = false
macos-titlebar-style = hidden
confirm-close-surface = false
minimum-contrast = 1
window-colorspace = srgb
window-decoration = auto
window-padding-x = 2
window-padding-y = 1
window-padding-balance = true
background-opacity = 1
background-blur = 50
unfocused-split-opacity = 0.75
split-divider-color = 000000
window-vsync = true
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/icons/catppuccin-latte.icns

cursor-style = block
cursor-style-blink = true
cursor-opacity = 1
focus-follows-mouse = true

mouse-hide-while-typing = true
shell-integration-features = no-cursor, sudo

quick-terminal-position = center
quick-terminal-size = 95%,70%
quick-terminal-animation-duration = 0.5
quick-terminal-space-behavior = move
quick-terminal-autohide = false

# Keybinds
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+,=toggle_split_zoom
keybind = cmd+shift+enter=new_split:auto
keybind = cmd+shift+minus=new_split:down
keybind = cmd+shift+backslash=new_split:right
keybind = cmd+shift+r=reload_config
keybind = cmd+shift+x=close_surface
# Resize
keybind = ctrl+-=resize_split:down,20
keybind = ctrl+==resize_split:up,20
keybind = ctrl+,=resize_split:left,20
keybind = ctrl+.=resize_split:right,20
keybind = ctrl+shift+==equalize_splits
# Quick term
keybind = global:cmd+\=toggle_quick_terminal
# Update
keybind = cmd+shift+u=check_for_updates

# Font Configs
font-size = 22
# config-file = fonts/TX-02
# config-file = fonts/ellograph
config-file = fonts/ioskeley
# config-file = fonts/lilex
# config-file = fonts/MDIO
