# Aliases
alias ff='fastfetch'
alias cat='bat'
alias cd='z'
alias lzg='lazygit'
alias brewrift='brew services restart rift'
alias brewbar='brew services restart sketchybar'
alias lzs='lazysql'
alias python3='/opt/homebrew/bin/python3.14'
alias nv='nvim'
alias chadneo='neovide --frame buttonless --title-hidden --no-vsync --no-idle'
alias vyneo='env NVIM_APPNAME=VyVim neovide --frame buttonless --title-hidden --no-vsync --no-idle'
alias y='Yazi'
alias vim='env NVIM_APPNAME=vim nvim'
alias nvtest='env NVIM_APPNAME=nvtest nvim'
alias vv='env NVIM_APPNAME=VyVim nvim'
alias nvcode='env NVIM_APPNAME=nvim-vscode nvim'
alias cls='clear'
alias rl='reset'
alias py='python3'
alias pip='pip3'
alias uvr='uv run'
alias venv='source .venv/bin/activate.fish'
alias ls='eza --group-directories-first --icons'
alias l='eza -a --group-directories-first --icons'
alias ll='eza -la --group-directories-first --icons'
alias lt='eza -a --group-directories-first --icons --tree'
alias tldr='tldr --list | fzf --preview "tldr {1} --color=always" --preview-window=right,60% | xargs tldr'
